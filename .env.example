# Development defaults. Copy to .env and replace the placeholders.
POSTGRES_USER=shuffle_user
POSTGRES_PASSWORD=change-this-before-deploy
POSTGRES_DB=shuffle_db
SUPERADMIN_EMAIL=majkic@gmail.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3010/api/auth/google/callback
APP_URL=http://localhost:3005
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgres://shuffle_user:change-this-before-deploy@localhost:5435/shuffle_db

# Deployment defaults
DEPLOY_HOST=root@ll.rs
DEPLOY_PATH=/opt/shuffle
APP_PORT=3005
POSTGRES_PORT=5435
