# Production template. Copy to .env.production and set real secrets.
POSTGRES_USER=shuffle_user
POSTGRES_PASSWORD=replace-with-a-unique-strong-database-password
POSTGRES_DB=shuffle_db
SUPERADMIN_EMAIL=majkic@gmail.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://shuffle.ll.rs/api/auth/google/callback
APP_URL=https://shuffle.ll.rs
SESSION_SECRET=replace-with-a-unique-random-secret
DATABASE_URL=postgres://shuffle_user:replace-with-a-unique-strong-database-password@localhost:5435/shuffle_db
PORT=3005
NODE_ENV=production

# Production deployment target; HTTPS reverse proxy should route shuffle.ll.rs to port 3005.
DEPLOY_HOST=root@ll.rs
DEPLOY_PATH=/opt/shuffle
APP_PORT=3005
POSTGRES_PORT=5435
